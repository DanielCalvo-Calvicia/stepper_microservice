# Service Bind Configuration
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8005

# Inbound HTTP Configuration
ALLOWED_ORIGINS=*

# Stepper Configuration (JSON)
# Define your steppers here with step, dir, and en pins (BCM numbering).
STEPPER_CONFIGS='{"stepper_1": {"step": 17, "dir": 27, "en": 5}, "stepper_2": {"step": 23, "dir": 24, "en": 25}}'

# Max speed constraint applied in the service layer if none provided (Steps per second)
DEFAULT_SPEED_LIMIT=1000.0

# Set to 1 to force the Mock Adapter even on a Raspberry Pi
MOCK_HARDWARE=0
